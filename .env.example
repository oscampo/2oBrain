# Copia este archivo a .env y llena los valores reales. .env nunca se
# commitea (ver .gitignore) -- los scripts en scripts/db/ y los servidores
# MCP lo leen directo, nunca llega al navegador del dashboard.

# Opcional (registro #691). Nombre de zona horaria IANA (ej. America/Bogota,
# Europe/Madrid, Asia/Tokyo) usada para calcular "hoy" al validar --date en
# remember.mjs/remember-batch.mjs y en los servidores MCP. Sin esto, el
# default es America/Bogota -- ponlo si vives en otra zona, si no ninguna
# fecha "de hoy" real va a coincidir y remember.mjs te va a bloquear siempre.
# Si despliegas un servidor MCP, este valor también hay que configurarlo ahí
# como secreto/env var por separado (ver Fase 8 de CLAUDE.md), .env solo lo
# leen los scripts locales.
TIMEZONE=

# Conexión directa a Postgres (Supabase) -- la usan los scripts scripts/db/*.mjs
# vía node-pg. Se obtiene en Supabase: Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=

# Usados por los servidores MCP (deno-deploy/, supabase/functions/) vía supabase-js.
# Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings (search.mjs, embed-records.mjs, embed-pages.mjs). voyage-4-lite.
# https://dash.voyageai.com/
VOYAGE_API_KEY=

# Clasificadores baratos y extracción de registros (Ollama Cloud, gpt-oss).
# https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Fallback/alternativa para síntesis y clasificación de mayor calidad (Gemini).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Solo si vas a desplegar el servidor MCP en Deno Deploy (deno-deploy/mcp-server).
# https://dash.deno.com/account#access-tokens
DENO_DEPLOY_TOKEN=
